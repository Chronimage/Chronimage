{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/src-tauri/target",
      "!**/models",
      "!**/src/routeTree.gen.ts",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/tests/visual-goldens/actual",
      "!**/tests/visual-goldens/diff"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "jsxQuoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } },
        "noDebugger": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "warn",
        "noNonNullAssertion": "warn",
        "useNodejsImportProtocol": "error"
      },
      "complexity": {
        "noForEach": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "nursery": {
        "useSortedClasses": "warn"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["**/*.test.{ts,tsx}", "**/tests/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off", "noConsole": "off" }
        }
      }
    },
    {
      "includes": ["**/.claude/hooks/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" },
          "style": {
            "useNodejsImportProtocol": "off",
            "useTemplate": "off",
            "noUnusedTemplateLiteral": "off",
            "useSingleVarDeclarator": "off"
          },
          "complexity": { "noForEach": "off" }
        }
      }
    }
  ]
}

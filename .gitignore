# Chronimage gitignore

# Node / Vite / TS
node_modules/
dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.turbo/
coverage/
.eslintcache
.tsbuildinfo
*.tsbuildinfo

# Rust / Cargo / Tauri
src-tauri/target/
src-tauri/Cargo.lock.bak
**/*.rs.bk
src-tauri/.cargo/
src-tauri/gen/
src-tauri/icons/*.png.bak

# Tauri build outputs
src-tauri/target/
src-tauri/release/

# Chronimage runtime state (never commit user data)
models/
!models/.gitkeep
# Bundled-model staging dir: track the directory but not the binary files.
# `scripts/fetch-bundled-models.*` populates this at build time.
!src-tauri/models/
!src-tauri/models/bundled/
!src-tauri/models/bundled/.gitkeep
src-tauri/models/bundled/*.onnx
src-tauri/models/bundled/*.gguf
src-tauri/models/bundled/*.json
**/catalog.db
**/catalog.db-journal
**/catalog.db-wal
**/catalog.db-shm
**/source_deletions.log
**/_edits/
**/_bin/
**/_thumbs/
chronimage-local/

# Test fixtures (binary photos held in Git LFS — but not the generated outputs)
tests/fixtures/tmp/
tests/visual-goldens/actual/
tests/visual-goldens/diff/
playwright-report/
test-results/

# Large phase-1 exit-criteria fixtures. Too big for LFS (~150–300 GB);
# regenerate locally with scripts/scan-raw-jpg-pairs.ps1 and friends. The
# exit tests gracefully skip when these dirs are absent.
tests/fixtures/raw-jpg-pairs/
tests/fixtures/catalog-size/
tests/fixtures/import-throughput/
tests/fixtures/source-cleanup/
tests/fixtures/rediscovery/
tests/fixtures/face-clusters/
# Only the tiny face-detect `group.jpg` is small enough to commit via LFS.

# OS / editors
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.iml
.fleet/

# OneDrive sync temp files (user's dev dir is on OneDrive)
*~
.~*
*.tmp

# Environment + secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
!tests/fixtures/*.pem

# Release artifacts (produced by CI, not committed)
*.msi
*.nsis
*.exe.signed
releases/

# Playwright
playwright/.cache/

# Criterion
target/criterion/

# Vitest
.vitest-cache/

# Biome
.biome-cache/

# Tauri updater private keys (signed uploads only)
~/.tauri/
!tauri-pub.pem
.claude/scheduled_tasks.lock


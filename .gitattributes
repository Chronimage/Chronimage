# Visual regression goldens
tests/visual-goldens/baseline/**/*.png filter=lfs diff=lfs merge=lfs -text

# Don't diff binary release artifacts if they sneak in
*.msi binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary

# Mark generated files so GitHub "Files changed" collapses them
pnpm-lock.yaml linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true

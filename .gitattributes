# Line endings
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.html text eol=lf

# Git LFS — binary test fixtures
tests/fixtures/photos/**/*.arw filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.ARW filter=lfs diff=lfs merge=lfs -text

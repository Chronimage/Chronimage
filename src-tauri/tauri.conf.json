{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronimage",
  "version": "0.1.0-dev",
  "identifier": "app.chronimage.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Chronimage",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "fullscreen": false,
        "focus": true,
        "visible": true,
        "maximized": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": ["mica"],
          "state": "active"
        }
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["models/bundled/*"],
    "copyright": "© 2026 Jay Amirineni",
    "shortDescription": "On-device AI photo organizer.",
    "longDescription": "Chronimage consolidates your fragmented photo library across Google Photos, iCloud, iPhone, and local disks; detects duplicates (including RAW+JPG pairs); and lets you reclaim cloud storage with verified local copies.",
    "category": "Photography",
    "publisher": "Chronimage",
    "homepage": "https://chronimage.app",
    "license": "UNLICENSED",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://releases.chronimage.app/stable.json"],
      "dialog": false,
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBKEY"
    }
  }
}

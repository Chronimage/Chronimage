# Chronimage — local dev env vars.
# Copy to `.env.local` and fill in real values. See docs/manual-setup.md.
#
# NEVER commit the populated file — `.env.local` is gitignored.

# ── GitHub CLI ──────────────────────────────────────────────────────────────
# PAT with `repo` + `workflow` scope. Generate at
# https://github.com/settings/tokens (classic). `gh` CLI + this session both
# read these for PR create / merge / checks.
GITHUB_TOKEN=
GH_TOKEN=

# ── Google Photos OAuth (optional) ──────────────────────────────────────────
# The bundled default client id at src-tauri/src/sources/google_photos.rs:93
# works for personal use. Override if you've registered your own OAuth client
# at https://console.cloud.google.com/apis/credentials.
CHRONIMAGE_GPHOTOS_CLIENT_SECRET=

# ── Microsoft Graph / OneDrive OAuth (deferred — Phase 2 §6 follow-up) ──────
# CHRONIMAGE_ONEDRIVE_CLIENT_SECRET=

# ── Optional dev-tool overrides ─────────────────────────────────────────────
# CHRONIMAGE_MODELS_DIR=
# CHRONIMAGE_THUMBNAILS_DIR=

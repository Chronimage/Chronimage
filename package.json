{
  "name": "chronimage",
  "private": true,
  "version": "0.1.0-dev",
  "type": "module",
  "description": "Windows-first, on-device AI photo organizer.",
  "author": "Jay Amirineni <jay@stackular.com>",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual-goldens",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "migrate:new": "node scripts/new-migration.cjs",
    "migrate:run": "cargo run -p chronimage-cli -- migrate",
    "forbidden-patterns": "node scripts/forbidden-patterns.cjs",
    "bundle-size": "node scripts/bundle-size-check.cjs",
    "prepare": "lefthook install",
    "changelog": "git-cliff --output CHANGELOG.md",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt": "biome check --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm clippy",
    "ci": "pnpm typecheck && pnpm lint && pnpm test:cov && pnpm clippy && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.64.0",
    "@tanstack/react-router": "^1.95.0",
    "@tanstack/react-virtual": "^3.11.2",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-log": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.3.0",
    "lucide-react": "^1.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@biomejs/biome": "^2.4.12",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.49.1",
    "@tanstack/react-query-devtools": "^5.64.0",
    "@tanstack/router-devtools": "^1.95.0",
    "@tanstack/router-plugin": "^1.95.0",
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "git-cliff": "^2.7.0",
    "jsdom": "^25.0.1",
    "lefthook": "^1.10.1",
    "playwright": "^1.49.1",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "typescript": "~6.0.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(cargo check*)",
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(cargo fetch*)",
      "Bash(cargo nextest*)",
      "Bash(cargo llvm-cov*)",
      "Bash(cargo audit*)",
      "Bash(cargo deny*)",
      "Bash(cargo tauri dev)",
      "Bash(cargo tauri icon*)",
      "Bash(cargo tauri info)",
      "Bash(rustup *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote -v)",
      "Bash(git stash*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git add*)",
      "Bash(git checkout*)",
      "Bash(git merge*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh workflow view*)",
      "Bash(ls*)",
      "Bash(find tests*)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(mkdir -p*)",
      "Bash(touch *)",
      "Bash(cp -r design-handoff/*)",
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Edit(src/**)",
      "Edit(src-tauri/src/**)",
      "Edit(src-tauri/Cargo.toml)",
      "Edit(src-tauri/tauri.conf.json)",
      "Edit(src-tauri/migrations/**)",
      "Edit(src-tauri/tests/**)",
      "Edit(src-tauri/benches/**)",
      "Edit(tests/**)",
      "Edit(scripts/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Edit(CLAUDE.md)",
      "Edit(README.md)",
      "Edit(package.json)",
      "Edit(tsconfig*.json)",
      "Edit(vite.config.ts)",
      "Edit(tailwind.config.ts)",
      "Edit(biome.json)",
      "Edit(lefthook.yml)",
      "Edit(commitlint.config.js)",
      "Edit(cliff.toml)",
      "Edit(playwright.config.ts)",
      "Edit(vitest.config.ts)",
      "Edit(cargo-deny.toml)",
      "Write(src/**)",
      "Write(src-tauri/**)",
      "Write(tests/**)",
      "Write(scripts/**)",
      "Write(docs/**)",
      "Write(.claude/**)",
      "Write(.github/**)",
      "Write(CLAUDE.md)",
      "Write(README.md)",
      "Write(package.json)",
      "Write(tsconfig*.json)",
      "Write(vite.config.ts)",
      "Write(tailwind.config.ts)",
      "Write(biome.json)",
      "Write(lefthook.yml)",
      "Write(commitlint.config.js)",
      "Write(cliff.toml)",
      "Write(playwright.config.ts)",
      "Write(vitest.config.ts)",
      "Write(cargo-deny.toml)",
      "Write(.gitignore)",
      "Write(.gitattributes)",
      "Write(.npmrc)",
      "Write(LICENSE)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(cargo tauri build*)",
      "Edit(design-handoff/**)",
      "Write(design-handoff/**)",
      "Edit(models/**)",
      "Write(models/**)",
      "Edit(src-tauri/target/**)",
      "Write(src-tauri/target/**)"
    ],
    "ask": [
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(git tag*)",
      "Bash(git cherry-pick*)",
      "Bash(git rebase*)",
      "Bash(pnpm install *)",
      "Bash(cargo install *)"
    ]
  },
  "env": {
    "RUST_BACKTRACE": "1",
    "RUST_LOG": "chronimage=debug,sqlx=warn,tauri=info",
    "TAURI_DEV_WINDOW_LABEL": "main"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit-format.cjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-bash-guard.cjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/remind-checkpoint.cjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.cjs"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-compact.cjs",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/statusline.cjs"
  }
}

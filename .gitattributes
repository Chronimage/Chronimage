tests/fixtures/photos/**/*.CR3 filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.nef filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.NEF filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.raf filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.RAF filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.dng filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.DNG filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.orf filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.ORF filter=lfs diff=lfs merge=lfs -text
tests/fixtures/photos/**/*.heic filter=lfs diff=lfs merge=lfs -text
